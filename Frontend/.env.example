# ===================================================================
# Variables de entorno - Frontend (Vite)
# ===================================================================
# Copia este archivo como ".env" y ajusta los valores.
#   cp .env.example .env
#
# IMPORTANTE:
#   - Solo las variables con prefijo VITE_ son expuestas al frontend.
#   - Reinicia el servidor de Vite (npm run dev) tras cambiar el .env.
#   - NO subas tu .env real al repositorio (debe estar en .gitignore).
# ===================================================================

# -------------------------------------------------------------------
# Destino del backend al que el proxy de Vite reenvía las llamadas /api
# -------------------------------------------------------------------
# El frontend hace peticiones a rutas relativas (/api/v1/...) y Vite
# las reenvía a esta URL. Elige UNA según cómo estés trabajando:
#
#   - Backend corriendo en tu PC:        http://localhost:8000
#   - Backend desplegado en Railway:     https://tu-backend.up.railway.app
#
VITE_API_PROXY_TARGET=http://localhost:8000
