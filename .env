# .env para el backend
# Configuración de la Base de Datos
DATABASE_URL=mysql+pymysql://usuario:contraseña@localhost:3306/nombre_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=tu_usuario_root
MYSQL_PASSWORD=tu_contraseña_segura
MYSQL_DATABASE=veterinaria_db

# Seguridad y Autenticación
SECRET_KEY=tu_secret_key_super_secreta_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Configuración del Proyecto
PROJECT_NAME="Sistema Veterinaria API"
VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Configuración de CORS (Orígenes permitidos)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
