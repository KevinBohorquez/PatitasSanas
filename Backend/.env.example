# Base de datos
DATABASE_URL=mysql+pymysql://root:password@mysql.railway.internal:3306/railway

# JWT / Autenticación
SECRET_KEY=generar_una_clave_larga_y_segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Entorno / CORS
ENVIRONMENT=production
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://patitas-sanas-sigma.vercel.app

# Envío de correos vía Brevo (API HTTPS) para recordatorios de citas
# Genera la API key en Brevo → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-tu_api_key_de_brevo
# Remitente: correo verificado en Brevo (sección Senders)
SMTP_FROM=tu_correo@gmail.com
# Opcional: nombre que verá el destinatario (por defecto "Patitas Sanas")
BREVO_SENDER_NAME=Patitas Sanas
